{
  "name": "xeno-platform",
  "version": "1.0.0",
  "private": true,
  "description": "XENO Platform - Monorepo for xenolabs studio and core libraries",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 5173",
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "powershell -Command \"cd src/server; npm run dev\"",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "build": "vite build",
    "setup": "node setup-dev.js",
    "install-server": "powershell -Command \"cd src/server; npm install\"",
    "xeno-api": "cd libs/xeno-edit/server && cargo run --release",
    "build:libs": "cd libs/xeno-lib && cargo build --release && cd ../xeno-edit/server && cargo build --release"
  },
