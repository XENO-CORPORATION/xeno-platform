{
  "name": "xeno-platform",
  "version": "1.0.0",
  "private": true,
  "description": "XENO Platform - Monorepo for xenostudio studio and core libraries",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 5183",
    "test": "npm run test:release-guard && npm run test:product-pages && npm run test:registration-gate && npm run test:forum-ranker && npm run test:forum-notify && npm run test:forum-edit-delete && npm run test:forum-moderation && npm run test:forum-throttle && npm run test:forum-writeback && npm run test:forum-report && npm run test:forum-digest && npm run test:forum-agents && npm run test:forum-seed && npm run test:forum-search && npm run test:forum-smoke-gates && npm run test:forum-mcp && npm run test:forum-widget && npm run test:forum-parity && npm run test:forum-xss && npm run test:sql-placeholders && npm run test:entitlements && npm run test:email && npm run test:account",
    "test:entitlements": "node --test scripts/entitlement-enforcement.test.mjs",
    "test:email": "node --test scripts/welcome-email.test.mjs",
    "test:account": "node --test scripts/spend-cap-enforcement.test.mjs scripts/security-events.test.mjs scripts/user-agent.test.mjs",
    "test:registration-gate": "node --test scripts/registration-gate.test.mjs scripts/client-ip.test.mjs",
    "test:forum-ranker": "node --test scripts/forum-ranker.test.mjs",
    "test:forum-edit-delete": "node --test scripts/forum-edit-delete.test.mjs scripts/forum-my-activity.test.mjs",
    "test:forum-widget": "node --test scripts/forum-product-widget.test.mjs",
    "test:forum-mcp": "node --test scripts/forum-mcp.test.mjs",
    "test:forum-smoke-gates": "node --test scripts/smoke-forum.test.mjs",
    "test:forum-search": "node --test scripts/forum-search.test.mjs",
    "test:forum-seed": "node --test scripts/forum-seed.test.mjs",
    "test:forum-agents": "node --test scripts/provision-forum-agents.test.mjs",
    "test:forum-digest": "node --test scripts/forum-digest.test.mjs",
    "test:forum-report": "node --test scripts/forum-report-intake.test.mjs",
    "test:forum-writeback": "node --test scripts/forum-writeback.test.mjs",
    "test:forum-throttle": "node --test scripts/forum-throttle.test.mjs",
    "test:forum-moderation": "node --test scripts/forum-moderation.test.mjs scripts/forum-moderation-ui.test.mjs",
    "test:forum-notify": "node --test scripts/forum-notify.test.mjs scripts/forum-notify-email.test.mjs scripts/forum-notification-ui.test.mjs",
    "test:release-guard": "node --test scripts/secret-box.test.mjs scripts/xeno-release.latest-yml.test.mjs scripts/release-guard.test.mjs scripts/publish-cli-releases.test.mjs scripts/amend-release-entry.test.mjs",
    "test:product-pages": "node --test scripts/experimental-notice.test.mjs scripts/product-privacy.test.mjs",
    "server": "powershell -Command \"cd src/server; npm run dev\"",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "build": "vite build && node scripts/prerender-products.mjs",
    "build:prerender": "node scripts/prerender-products.mjs",
    "verify:acp-launch": "node scripts/verify-acp-launch-content.mjs",
    "smoke:public-auth": "node scripts/smoke-public-auth.mjs",
    "smoke:public-api": "node scripts/smoke-public-api.mjs",
    "proof:forum-erasure": "node scripts/forum-erasure-proof.mjs",
    "proof:forum-moderation": "node scripts/forum-moderation-proof.mjs",
    "proof:forum-agent-surface": "node scripts/forum-agent-surface-proof.mjs",
    "test:forum-parity": "node --test scripts/forum-surface-parity.test.mjs",
    "test:forum-xss": "node --test scripts/forum-xss.test.mjs",
    "test:sql-placeholders": "node --test scripts/check-sql-placeholders.test.mjs && node scripts/check-sql-placeholders.mjs",
    "proof:forum-throttle": "node scripts/forum-throttle-proof.mjs",
    "proof:forum-report": "node scripts/forum-report-proof.mjs",
    "proof:forum-push": "node scripts/forum-push-proof.mjs",
    "smoke:forum-widget": "node scripts/forum-widget-render.mjs",
    "smoke:forum": "node scripts/smoke-forum.mjs",
    "models:catalog": "node scripts/publish-local-model-catalog.mjs",
    "models:catalog:upload": "node scripts/publish-local-model-catalog.mjs --upload",
    "setup": "node setup-dev.js",
    "install-server": "powershell -Command \"cd src/server; npm install\"",
    "xeno-api": "cd libs/xeno-edit/server && cargo run --release",
    "build:libs": "cd libs/xeno-lib && cargo build --release && cd ../xeno-edit/server && cargo build --release"
  },
