# Backend Dockerfile
FROM node:20-alpine

# Install FFmpeg, ImageMagick, Python3, and yt-dlp for media downloads
RUN apk add --no-cache ffmpeg imagemagick python3 py3-pip \
    && pip3 install --break-system-packages yt-dlp

# Set working directory
WORKDIR /app

# Copy package files from server directory
COPY src/server/package*.json ./

# Install dependencies
RUN npm install --omit=dev

# Copy server source code
COPY src/server/ ./

# Create uploads, conversions, and downloads directories
RUN mkdir -p uploads sam2-uploads storage conversions downloads

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Start the server
CMD ["npm", "start"]
