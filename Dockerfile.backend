# Backend Dockerfile — Hardened for Production
FROM node:20-alpine

# Install FFmpeg, ImageMagick, Python3, and yt-dlp for media downloads
# Also install dumb-init for proper signal handling
RUN apk add --no-cache ffmpeg imagemagick python3 py3-pip dumb-init \
    && pip3 install --break-system-packages yt-dlp

# Set working directory
WORKDIR /app

# Copy package files from server directory
COPY src/server/package*.json ./

# Install dependencies (production only)
RUN npm install --omit=dev && npm cache clean --force

# Copy server source code
COPY src/server/ ./

# Create uploads, conversions, and downloads directories
RUN mkdir -p uploads sam2-uploads storage conversions downloads

# SECURITY: Create non-root user and set ownership
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /app

# SECURITY: Switch to non-root user
USER appuser

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/api/status', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Use dumb-init to handle signals properly (graceful shutdown)
ENTRYPOINT ["dumb-init", "--"]

# Start the server
CMD ["npm", "start"]
