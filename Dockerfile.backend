# Backend Dockerfile — Hardened for Production
FROM node:22-alpine3.22@sha256:cd7807368cf24826297cbad5dca1a44972ccfd770647db52a8c7589eb4599ac8

# Install FFmpeg, ImageMagick, Python3, and yt-dlp for media downloads
# Also install dumb-init for proper signal handling
# 2026-09-12: a sha256 pin on the ClamAV definitions was removed from the RUN
# below. It was a GATE THAT COULD NOT PASS: freshclam fetches the CURRENT
# definitions and daily.cvd changes every day by design, so hashes recorded
# once matched only on the day they were written. Every build afterwards
# succeeded purely from Docker's layer cache, and the first build after a
# `docker builder prune` failed - which is what made the production image
# unbuildable from source, and is the real reason this box was a snowflake.
#
# Integrity is not lost: CVD files are DIGITALLY SIGNED by ClamAV and freshclam
# verifies that signature before writing them. The sha256 layer added nothing
# except a daily expiry. The `test -s` calls keep the build honest about
# freshclam having actually produced the files.
RUN apk add --no-cache ffmpeg imagemagick python3 py3-pip dumb-init \
      clamav=1.4.3-r0 poppler-utils=25.04.0-r0 \
      tesseract-ocr=5.5.0-r2 tesseract-ocr-data-eng=5.5.0-r2 font-dejavu=2.37-r6 \
    && pip3 install --break-system-packages yt-dlp \
    && freshclam --datadir=/var/lib/clamav \
    && test -s /var/lib/clamav/daily.cvd \
    && test -s /var/lib/clamav/main.cvd

# SECURITY: Create non-root user early (before COPY --chown)
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Copy package files from server directory (with correct ownership)
COPY --chown=appuser:appgroup src/server/package*.json ./

# Copy server source code (with correct ownership — avoids expensive recursive chown).
COPY --chown=appuser:appgroup src/server/ ./

# The production host may contain an untracked src/server/node_modules tree. Even
# if an older Docker implementation fails to honor the nested ignore pattern,
# it cannot replace the lockfile graph: delete it after COPY, then install last.
RUN rm -rf node_modules && \
    npm ci --omit=dev && \
    npm cache clean --force && \
    chown -R appuser:appgroup node_modules

# Create uploads, conversions, and downloads directories.
# NOTE: fileSystemRoutes.js resolves its upload dir cwd-relative as
# `process.cwd()/src/server/uploads` → /app/src/server/uploads. The previously
# deployed image had this baked from an older Dockerfile; recreate it so boot
# doesn't EACCES on the first mkdir. (Additive parity fix.)
RUN mkdir -p uploads sam2-uploads storage conversions downloads src/server/uploads extractor-jobs && \
    chown -R appuser:appgroup uploads sam2-uploads storage conversions downloads src/server extractor-jobs

# Which commit this image was built from, baked in LAST so a new SHA does not
# invalidate the apk and npm layers above. Passed by scripts/remote-deploy.sh;
# empty on a local build, which is why the value is written verbatim and the
# server reports "unknown" rather than inventing one.
ARG XENO_SOURCE_REVISION=""
LABEL org.opencontainers.image.revision=$XENO_SOURCE_REVISION
RUN printf '%s' "$XENO_SOURCE_REVISION" > /app/.xeno-revision &&     chown appuser:appgroup /app/.xeno-revision

# SECURITY: Switch to non-root user
USER appuser

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/api/ready', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Use dumb-init to handle signals properly (graceful shutdown)
ENTRYPOINT ["dumb-init", "--"]

# Start the server
CMD ["npm", "start"]
