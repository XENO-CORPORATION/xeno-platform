art/

# Local dev logs & scratch
.dev-logs/
tmp-*

# Regenerated DOM-test bundle, not application source.
# Every DOM-test harness bundle is regenerated by its own test, never source.
# Named individually until 2026-09-09: the fourth one (.account-actions) was
# left untracked-but-unignored, so a generated file was one `git add -A` from
# being committed. A pattern cannot be forgotten the way a list can.
scripts/harness/.*.generated.mjs

# DR: Postgres backup dumps live under backups/ on the server checkout — never commit them
backups/
*.dump
*.dump.partial

# Runtime user uploads are persistent data, never product source.
src/server/uploads/

# Generated audit reports and verified-input caches are retained on disk and
# linked from release-evidence receipts, never shipped as application source.
.compliance/

# Repository recovery metadata is not product content. Keep local copies intact.
.git.backup/

# Private dev-access secrets. These patterns existed ONLY in the copy of
# .gitignore on xeno-platform-001 and were never committed — found 2026-07-30
# while reconciling that box against main. Catching the box up with
# `git reset --hard origin/main` would have deleted them, making an htpasswd
# file, a private nginx config and a secrets directory git-visible on the
# machine where they actually exist. Committing them first makes that reset safe.
*.htpasswd
nginx-private.conf
.bunker-secrets/
secrets/

# Deploy archives — `git archive HEAD` output from scripts/deploy-platform.mjs and
# hand-rolled equivalents. Large, regenerated every deploy, and never source.
# Ignored because `git add -A` has swept foreign files into a commit twice here.
deploy*.tar
