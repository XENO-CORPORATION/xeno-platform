# Frontend Dockerfile - Optimized for faster builds
FROM node:20-alpine AS builder

# Build arguments for Vite environment variables (NON-SECRET ONLY).
# Provider API keys are NEVER baked into the frontend image — all inference and
# media generation route through the authed, metered backend (api.xenostudio.ai).
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_ENABLE_SITE_GATE
ARG VITE_SITE_PASSWORD

# Set environment variables for build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_ENABLE_SITE_GATE=$VITE_ENABLE_SITE_GATE
ENV VITE_SITE_PASSWORD=$VITE_SITE_PASSWORD

# Set working directory
WORKDIR /app

# Copy package files first to leverage Docker cache
COPY package*.json ./

# Clean install for reproducible builds (uses package-lock.json).
#
# ── THE CACHE MOUNT IS THE POINT, AND IT IS NOT THE LAYER CACHE ─────────────
#
# Docker already caches this LAYER on the hash of package*.json. The problem is
# that the layer is invalidated by ANY edit to package.json — including adding an
# npm script, which is not a dependency change at all. Measured on the box:
# `npm ci` is 73s of a 122s build, and a run of adding test scripts paid it every
# single time.
#
# `--mount=type=cache` keeps npm's own download cache across builds, so an
# invalidated layer re-links from disk instead of re-fetching the registry. It
# changes nothing about WHAT is installed — package-lock.json still decides that,
# so the build stays reproducible.
#
# ⚠️ Requires BuildKit, which `docker compose build` already uses here. On a
# builder without it this line is a syntax error rather than a silent no-op,
# which is the failure mode you want.
RUN --mount=type=cache,target=/root/.npm npm ci --legacy-peer-deps

# Copy configuration files (these rarely change, so cache them before src/)
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts ./
COPY tailwind.config.js postcss.config.js ./
COPY components.json ./
COPY index.html ./

# Copy static assets
COPY public/ ./public/

# Copy source code (this layer invalidates when source changes)
COPY src/ ./src/
COPY packages/ ./packages/

# Copy build scripts (the build runs scripts/prerender-products.mjs — SEO §8)
COPY scripts/ ./scripts/

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Override main nginx.conf to add global upload limit
RUN sed -i '/http {/a \    client_max_body_size 500M;' /etc/nginx/nginx.conf

# Copy nginx configuration with large file upload support
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
