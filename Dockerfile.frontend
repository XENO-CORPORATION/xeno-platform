# Frontend Dockerfile - Optimized for faster builds
FROM node:20-alpine AS builder

# Build arguments for Vite environment variables
ARG VITE_OPENAI_API_KEY
ARG VITE_GEMINI_API_KEY
ARG VITE_OPENROUTER_API_KEY
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_ENABLE_SITE_GATE
ARG VITE_SITE_PASSWORD

# Set environment variables for build
ENV VITE_OPENAI_API_KEY=$VITE_OPENAI_API_KEY
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
ENV VITE_OPENROUTER_API_KEY=$VITE_OPENROUTER_API_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_ENABLE_SITE_GATE=$VITE_ENABLE_SITE_GATE
ENV VITE_SITE_PASSWORD=$VITE_SITE_PASSWORD

# Set working directory
WORKDIR /app

# Copy package files first to leverage Docker cache
COPY package*.json ./

# Clean install for reproducible builds (uses package-lock.json)
RUN npm ci --legacy-peer-deps

# Copy configuration files (these rarely change, so cache them before src/)
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts ./
COPY tailwind.config.js postcss.config.js ./
COPY components.json ./
COPY index.html ./

# Copy static assets
COPY public/ ./public/

# Copy source code (this layer invalidates when source changes)
COPY src/ ./src/

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Override main nginx.conf to add global upload limit
RUN sed -i '/http {/a \    client_max_body_size 500M;' /etc/nginx/nginx.conf

# Copy nginx configuration with large file upload support
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
