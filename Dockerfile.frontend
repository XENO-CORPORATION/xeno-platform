# Frontend Dockerfile
FROM node:20-alpine AS builder

# Build arguments for Vite environment variables
ARG VITE_FAL_KEY
ARG VITE_OPENAI_API_KEY
ARG VITE_GEMINI_API_KEY
ARG VITE_OPENROUTER_API_KEY
ARG VITE_API_URL
ARG VITE_ENABLE_SITE_GATE
ARG VITE_SITE_PASSWORD

# Set environment variables for build
ENV VITE_FAL_KEY=$VITE_FAL_KEY
ENV VITE_OPENAI_API_KEY=$VITE_OPENAI_API_KEY
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
ENV VITE_OPENROUTER_API_KEY=$VITE_OPENROUTER_API_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ENABLE_SITE_GATE=$VITE_ENABLE_SITE_GATE
ENV VITE_SITE_PASSWORD=$VITE_SITE_PASSWORD

# Set working directory
WORKDIR /app

# Copy package files first to leverage Docker cache
COPY package*.json ./

# Install dependencies (including dev dependencies for build)
# Using npm install instead of npm ci to handle package.json changes
RUN npm install --legacy-peer-deps

# Workaround for npm optional dependencies bug and esbuild version mismatch
RUN rm -rf node_modules/.vite .npm && npm install --force --legacy-peer-deps

# Clear esbuild cache and force rebuild
RUN rm -rf node_modules/.vite && npm cache clean --force

# Remove existing esbuild binary to force redownload
RUN rm -f node_modules/.bin/esbuild

# Update browserslist data
RUN npx update-browserslist-db@latest

# Clean install before build to fix dependency issues
RUN rm -rf node_modules package-lock.json && npm install

# Fix entities package issue
RUN npm install entities --force

# Force install correct esbuild version that matches host (after clean install)
RUN npm install esbuild@0.25.1 --force

# Copy source code (this will invalidate cache when source changes)
COPY . .

# Build the application with esbuild workaround
RUN ESBUILD_BINARY_PATH="" npm run build

# Production stage
FROM nginx:alpine

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Override main nginx.conf to add global upload limit
RUN sed -i '/http {/a \    client_max_body_size 500M;' /etc/nginx/nginx.conf

# Copy nginx configuration with large file upload support
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
