{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@xenosystem/elements/schema": ["packages/elements/src/schema.ts", "../xeno-elements/packages/elements/src/schema.ts"],
      "@xenosystem/elements/tokens": ["packages/elements/src/tokens/index.ts", "../xeno-elements/packages/elements/src/tokens/index.ts"],
      "@xenosystem/elements/elements/*": ["packages/elements/src/elements/*", "../xeno-elements/packages/elements/src/elements/*"],
      "@xenosystem/elements": ["packages/elements/src/index.ts", "../xeno-elements/packages/elements/src/index.ts"],
      "@xenosystem/generate": ["packages/generate/src/index.ts", "../xeno-elements/packages/generate/src/index.ts"],
      "@xenosystem/elements-react": ["packages/elements-react/src/index.ts", "../xeno-elements/packages/elements-react/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": [
    "node_modules",
    "src/components/playground/Studio/VideoStudio/components/_old_backup/VideoStudio_OLD.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
