  try {
    const result = await selectBillingWorkspace(
      req.db,
      req.user.id,
      req.params.workspaceId,
      {
        ...PLATFORM_ACCOUNT_OPTIONS,
        projectId: typeof req.body?.projectId === 'string' ? req.body.projectId : null,
      }
    );

    res.json({
      success: true,
      workspace: result.workspace,
      project: result.project,
    });
  } catch (error) {
    const status = /not found/i.test(error.message) ? 400 : 500;
    console.error('Select workspace error:', error);
    res.status(status).json({
      success: false,
      error: error.message || 'Failed to select workspace',
    });
