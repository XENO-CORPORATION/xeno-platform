// GET /api/auth/usage - Get usage statistics
router.get('/usage', async (req, res) => {
  try {
    const { user: authUser } = await requireAuthenticatedUser(req, { requireSession: true });
    const snapshot = await getCreditSnapshot(req.db, authUser.id);

    const userResult = await req.db.query(
      'SELECT id, credits, bonus_credits_claimed, created_at FROM users WHERE id = $1',
      [authUser.id]
    );

    if (userResult.rows.length === 0 || !snapshot) {
      return res.status(404).json({
        success: false,
        error: 'User not found'
      });
    }

    const usageUser = userResult.rows[0];

    // Get usage history from credit_usage table if it exists
    let usageHistory = [];
    try {
      const usageResult = await req.db.query(`
        SELECT feature, credits_used, created_at
        FROM credit_usage
        WHERE user_id = $1
        ORDER BY created_at DESC
        LIMIT 50
      `, [usageUser.id]);
      usageHistory = usageResult.rows;
    } catch (e) {
      // Table might not exist yet, that's okay
      console.log('credit_usage table not found, returning empty history');
    }

    const billingProfile = await getUserBillingProfile(req.db, usageUser.id, PLATFORM_RUNTIME_BILLING_OPTIONS);

    // Prefer canonical ledger/account values when available.
    const totalCreditsEarned = billingProfile?.account
      ? Number(billingProfile.account.lifetime_earned || 0) / 1000000
      : (usageUser.bonus_credits_claimed ? 1000 : 0);
    const creditsUsed = billingProfile?.account
      ? Number(billingProfile.account.lifetime_spent || 0) / 1000000
      : Math.max(0, totalCreditsEarned - (snapshot.currentCredits || 0));

    res.json({
      success: true,
      usage: {
        current_credits: snapshot.currentCredits,
        total_credits_earned: totalCreditsEarned,
        credits_used: creditsUsed > 0 ? creditsUsed : 0,
        bonus_claimed: usageUser.bonus_credits_claimed,
        member_since: usageUser.created_at,
        history: usageHistory,
        workspace: billingProfile?.workspace
          ? {
              id: billingProfile.workspace.id,
              name: billingProfile.workspace.name,
              slug: billingProfile.workspace.slug,
            }
          : null,
        default_project: billingProfile?.project
          ? {
              id: billingProfile.project.id,
              name: billingProfile.project.name,
              slug: billingProfile.project.slug,
            }
          : null,
      }
    });

  } catch (error) {
    if (isAuthError(error)) {
      return sendAuthError(res, error);
