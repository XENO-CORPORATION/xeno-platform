    const returnUrl = stateData.returnUrl || '/overview';
    handleOAuthRedirect(res, returnUrl, jwtToken, isNew);

  } catch (error) {
    console.error('Google OAuth callback error:', error);
    res.redirect(`${FRONTEND_URL}/auth?error=callback_failed`);
