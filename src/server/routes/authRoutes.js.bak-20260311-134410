async function createTrackedSession(db, userId, token, req, metadata = {}) {
  await ensureAuthSecurityTables(db);
  const userAgent = req.get('User-Agent') || null;
  const tokenHash = await bcrypt.hash(token, 10);
  const accessTokenHash = hashAccessToken(token);

  const result = await db.query(
    `INSERT INTO user_sessions (
       user_id,
       token_hash,
       session_token,
       access_token_hash,
       expires_at,
       created_at,
       updated_at,
       last_seen_at,
       ip_address,
       user_agent,
       device_type,
       browser,
       metadata
     )
     VALUES (
       $1::uuid,
       $2::varchar,
       $3::varchar,
       $4::varchar,
       NOW() + INTERVAL '7 days',
       NOW(),
       NOW(),
       NOW(),
       $5::inet,
       $6::text,
       $7::varchar,
       $8::varchar,
       $9::jsonb
     )
     RETURNING id::text as id`,
    [
      userId,
      tokenHash,
      token,
      accessTokenHash,
      req.ip || null,
      userAgent,
      inferDeviceType(userAgent),
      inferBrowser(userAgent),
      JSON.stringify(metadata || {}),
    ]
  );

  return result.rows[0] || null;
}

async function findSessionByToken(db, userId, token) {
  await ensureAuthSecurityTables(db);
  const accessTokenHash = hashAccessToken(token);
  const result = await db.query(
    `SELECT
       id::text as id,
       user_id::text as "userId",
       token_hash as "tokenHash",
       session_token as "sessionToken",
       access_token_hash as "accessTokenHash",
       expires_at as "expiresAt",
       created_at as "createdAt",
       updated_at as "updatedAt",
       last_seen_at as "lastSeenAt",
       ip_address::text as "ipAddress",
       user_agent as "userAgent",
       device_type as "deviceType",
       browser,
       revoked_at as "revokedAt",
       revoked_reason as "revokedReason",
       metadata
     FROM user_sessions
     WHERE user_id = $1::uuid
       AND expires_at > NOW()
       AND revoked_at IS NULL
     ORDER BY created_at DESC
     LIMIT 100`,
    [userId]
  );

  for (const row of result.rows) {
    if (row.sessionToken && row.sessionToken === token) {
      return row;
    }
    if (row.accessTokenHash && row.accessTokenHash === accessTokenHash) {
      return row;
    }
    if (row.tokenHash) {
      const matches = await bcrypt.compare(token, row.tokenHash).catch(() => false);
      if (matches) {
        return row;
      }
    }
  }

  return null;
}

async function authenticateJwtRequest(db, token, options = {}) {
  if (!token) {
    throw new Error('Authentication required');
  }

  await ensureAuthSecurityTables(db);
  const decoded = jwt.verify(token, JWT_SECRET);
  const result = await db.query(
    `SELECT id, username, email, display_name, avatar_url,
            created_at, email_verified, is_active, last_login, credits, bonus_credits_claimed, role, plan
     FROM users
     WHERE id = $1
       AND is_active = true
     LIMIT 1`,
    [decoded.userId]
  );

  const user = result.rows[0] || null;
  if (!user) {
    throw new Error('Invalid token');
  }

  const session = await findSessionByToken(db, user.id, token);
  if (options.requireSession && !session) {
    throw new Error('Invalid session');
  }

  if (session && options.touchSession !== false) {
    await db.query(
      `UPDATE user_sessions
       SET last_seen_at = NOW(),
           updated_at = NOW()
       WHERE id = $1::uuid`,
      [session.id]
    );
  }

  return { decoded, user, session };
}

async function listSecuritySessions(db, userId, currentToken) {
  await ensureAuthSecurityTables(db);
  const currentSession = currentToken ? await findSessionByToken(db, userId, currentToken) : null;
  const result = await db.query(
    `SELECT
       id::text as id,
       expires_at as "expiresAt",
       created_at as "createdAt",
       updated_at as "updatedAt",
       last_seen_at as "lastSeenAt",
       ip_address::text as "ipAddress",
       user_agent as "userAgent",
       device_type as "deviceType",
       browser,
       metadata
     FROM user_sessions
     WHERE user_id = $1::uuid
       AND expires_at > NOW()
       AND revoked_at IS NULL
     ORDER BY created_at DESC`,
    [userId]
  );

  return result.rows.map((row) => ({
    ...row,
    isCurrent: currentSession ? row.id === currentSession.id : false,
  }));
}

async function revokeSecuritySession(db, userId, sessionId, reason = 'manual_revoke') {
  await ensureAuthSecurityTables(db);
  const result = await db.query(
    `UPDATE user_sessions
     SET revoked_at = NOW(),
         revoked_reason = $3::varchar,
         updated_at = NOW()
     WHERE id = $1::uuid
       AND user_id = $2::uuid
       AND revoked_at IS NULL
     RETURNING id::text as id`,
    [sessionId, userId, reason]
  );

  return result.rows[0] || null;
}

async function revokeAllOtherSecuritySessions(db, userId, currentToken, reason = 'revoke_all_other_sessions') {
  await ensureAuthSecurityTables(db);
  const currentSession = currentToken ? await findSessionByToken(db, userId, currentToken) : null;
  const result = await db.query(
    `UPDATE user_sessions
     SET revoked_at = NOW(),
         revoked_reason = $3::varchar,
         updated_at = NOW()
     WHERE user_id = $1::uuid
       AND revoked_at IS NULL
       AND expires_at > NOW()
       AND ($2::uuid IS NULL OR id <> $2::uuid)
     RETURNING id::text as id`,
    [userId, currentSession?.id || null, reason]
  );

  return {
    revokedCount: result.rowCount || 0,
    currentSessionId: currentSession?.id || null,
  };
}

async function listSecurityEvents(db, userId, options = {}) {
  await ensureAuthSecurityTables(db);
  const limit = Math.max(1, Math.min(Number(options.limit) || 50, 200));
  const eventTypes = Array.isArray(options.eventTypes) ? options.eventTypes.filter(Boolean) : [];
  const result = await db.query(
    `SELECT
       id::text as id,
       event_type as "eventType",
       ip_address::text as "ipAddress",
       user_agent as "userAgent",
       metadata,
       created_at as "createdAt"
     FROM security_events
     WHERE user_id = $1::uuid
       AND ($2::text[] IS NULL OR event_type = ANY($2::text[]))
     ORDER BY created_at DESC
     LIMIT $3`,
    [userId, eventTypes.length > 0 ? eventTypes : null, limit]
  );

  return result.rows;
}

