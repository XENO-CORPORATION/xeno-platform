// DELETE /api/auth/security/sessions/:sessionId - Revoke one session
router.delete('/security/sessions/:sessionId', async (req, res) => {
  try {
    const { user, session: currentSession } = await requireAuthenticatedUser(req, { requireSession: true });
    const { sessionId } = req.params;
    const revoked = await revokeSecuritySession(req.db, user.id, sessionId, 'manual_revoke');

    if (!revoked) {
      return res.status(404).json({
        success: false,
        error: 'Session not found'
      });
    }

    await logSecurityEvent(req.db, {
      userId: user.id,
      eventType: 'session_revoked',
      ipAddress: req.ip || null,
      userAgent: req.get('User-Agent') || null,
      metadata: {
        sessionId,
        revokedByCurrentSession: currentSession?.id || null,
        revokedCurrentSession: currentSession?.id === sessionId,
      },
    });

    res.json({
      success: true,
      revoked_session_id: sessionId,
      revoked_current_session: currentSession?.id === sessionId,
    });
  } catch (error) {
    if (isAuthError(error)) {
      return sendAuthError(res, error);
    }

    console.error('Security session revoke error:', error);
    res.status(500).json({
      success: false,
      error: 'Failed to revoke session',
      message: error.message
    });
  }
});

