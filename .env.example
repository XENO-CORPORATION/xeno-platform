# ==============================================
# XENOSTUDIO COMPLETE ENVIRONMENT SETUP
# ==============================================
# Copy this content to your .env file in the root directory

# ==============================================
# PROVIDER API KEYS — SERVER-SIDE ONLY
# ==============================================
# SECURITY: provider keys must NEVER be VITE_/NEXT_PUBLIC_ prefixed or otherwise
# exposed to the browser bundle. All inference and media generation route through
# the authed, metered backend, which holds these keys and proxies to providers /
# api.xenostudio.ai. Set them WITHOUT a VITE_ prefix so they stay on the server.

# Google/Gemini — Required for: Gemini models, image analysis, prompt generation
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — Required for: OpenAI models, GPT-4, DALL-E, server-side features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# fal.ai — Required for: Imagen 3/4, Stable Diffusion (server-side image gen)
# Get your key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_api_key_here

# ==============================================
# OPENROUTER API KEY
# ==============================================
# Required for: Multiple AI model routing, chat interfaces
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================
# REPLICATE API TOKEN
# ==============================================
# Required for: Video generation, audio generation, various AI models
# Get your key from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ==============================================
# TOPAZ LABS API KEY (SERVER-SIDE ONLY)
# ==============================================
# Required for: Image/video enhancement and upscaling
# Contact Topaz Labs for API access.
# NOTE: never expose this to the browser (no NEXT_PUBLIC_/VITE_ prefix). Topaz calls
# must be proxied through the authed, metered backend once that endpoint exists.
TOPAZ_LABS_API_KEY=your_topaz_labs_api_key_here

# ==============================================
# SECURITY & AUTH (CRITICAL — must set in production)
# ==============================================
# JWT secret — MUST be changed from default in production (min 32 bytes)
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Database password — MUST be changed from default
POSTGRES_PASSWORD=change-me-in-production

# Admin user password — MUST be changed from default
ADMIN_PASSWORD=change-me-in-production

# CORS origins (comma-separated, used in production)
CORS_ORIGINS=https://xenostudio.ai,https://www.xenostudio.ai

# Cookie domain for auth cookies
COOKIE_DOMAIN=.xenostudio.ai

# Frontend URL for OAuth redirects
AUTH_FRONTEND_URL=https://xenostudio.ai

# ==============================================
# STRIPE BILLING (pay path → credit ledger)
# ==============================================
# The server runs fully WITHOUT these — /api/billing endpoints return 503 until
# STRIPE_SECRET_KEY is set. No other product is affected. Get keys at:
#   https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret — `stripe listen` (dev) or the dashboard endpoint (prod).
# Point the endpoint at: https://xenostudio.ai/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Absolute app URL for Checkout success/cancel redirects (falls back to req origin).
BILLING_APP_URL=https://xenostudio.ai
#
# Stripe Price IDs — create Products + Prices in the Stripe dashboard and paste
# their price_… ids below. An item with no price id shows as unavailable (no error).
#   CREDITS_SMALL  → one-time   1,000 credits  (~$10)
#   CREDITS_MEDIUM → one-time   5,500 credits  (~$50)
#   CREDITS_LARGE  → one-time  12,000 credits  (~$100)
#   PRO_MONTHLY    → subscription  Pro   ($20/mo → 2,500 credits/mo)
#   TEAM_MONTHLY   → subscription  Team  ($60/mo → 8,000 credits/mo)
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# ==============================================
# DEVELOPMENT/TESTING VARIABLES
# ==============================================
# Test variable for development purposes
VITE_TEST_VAR=test_value

# Backend server port (to avoid conflicts)
BACKEND_PORT=3003

# API URL for frontend to connect to backend
VITE_API_URL=http://localhost:8081

# ==============================================
# SITE-WIDE PASSWORD PROTECTION
# ==============================================
# Enable/disable the password gate for the entire website
# Set to 'true' to enable, 'false' to disable
VITE_ENABLE_SITE_GATE=false

# The password required to access the site when gate is enabled
# This is a frontend-only protection for beta/construction mode
# WARNING: Not secure - password visible in frontend bundle
VITE_SITE_PASSWORD=your_secret_password_here

# ==============================================
# OPTIONAL: XENO SEARCH SERVICE
# ==============================================
# If you have a custom search service
XENO_SEARCH_API_KEY=your_xeno_search_api_key_here
XENO_SEARCH_ENDPOINT=your_xeno_search_endpoint_here

# ==============================================
# OPTIONAL: CLI REMOTE RUNNER
# ==============================================
# Leave unset to advertise no hosted run capabilities.
# Example: XENO_REMOTE_RUNNER_COMMAND=xeno
# Default args when enabled: run --json {prompt}
XENO_REMOTE_RUNNER_COMMAND=
XENO_REMOTE_RUNNER_ARGS_JSON=
XENO_REMOTE_RUNNER_CWD=
XENO_REMOTE_RUNNER_MAX_CONCURRENT=1
XENO_REMOTE_RUNNER_AUTOSCALE=false
XENO_REMOTE_RUNNER_AUTOSCALE_MIN=1
XENO_REMOTE_RUNNER_AUTOSCALE_MAX=
XENO_REMOTE_RUNNER_TIMEOUT_MS=1800000
XENO_REMOTE_RUNNER_RETENTION=100
XENO_REMOTE_RUNNER_MAX_PROMPT_CHARS=20000
XENO_REMOTE_RUNNER_MAX_EVENT_TEXT_CHARS=16000
# Comma-separated env var names to pass into runner child processes.
# Server env is not inherited by default.
XENO_REMOTE_RUNNER_ENV_ALLOWLIST=
# Optional: copy this server env var into XENO_API_KEY for the runner child.
XENO_REMOTE_RUNNER_API_KEY_ENV=

# ==============================================
# SPECIFIC FEATURE CONFIGURATIONS
# ==============================================

# Audio Generation Services
AUDIO_SERVICE_API_KEY=your_audio_service_key_here

# Video Enhancement Services
VIDEO_ENHANCE_API_KEY=your_video_enhance_key_here

# Image Enhancement Services
IMAGE_ENHANCE_API_KEY=your_image_enhance_key_here

# 3D Generation Services
THREED_GENERATION_API_KEY=your_3d_generation_key_here

# ==============================================
# API ENDPOINTS (Usually default, but configurable)
# ==============================================
REPLICATE_API_ENDPOINT=https://api.replicate.com
FAL_API_ENDPOINT=https://queue.fal.run
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1

# ==============================================
# XENO EXTENSION RELEASES
# ==============================================
EXTENSION_RELEASES_REPO=XENO-CORPORATION/xeno-extension
GITHUB_TOKEN=
EXTENSION_CHROME_STABLE_URL=
EXTENSION_CHROME_BETA_URL=
EXTENSION_CHROME_PREVIEW_URL=
EXTENSION_EDGE_STABLE_URL=
EXTENSION_EDGE_BETA_URL=
EXTENSION_EDGE_PREVIEW_URL=
EXTENSION_SAFARI_STABLE_URL=
EXTENSION_SAFARI_BETA_URL=
EXTENSION_SAFARI_PREVIEW_URL=
