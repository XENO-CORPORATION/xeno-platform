# ==============================================
# XENOSTUDIO COMPLETE ENVIRONMENT SETUP
# ==============================================
# Copy this content to your .env file in the root directory

# ==============================================
# PROVIDER API KEYS — SERVER-SIDE ONLY
# ==============================================
# SECURITY: provider keys must NEVER be VITE_/NEXT_PUBLIC_ prefixed or otherwise
# exposed to the browser bundle. All inference and media generation route through
# the authed, metered backend, which holds these keys and proxies to providers /
# api.xenostudio.ai. Set them WITHOUT a VITE_ prefix so they stay on the server.

# OpenAI
# TRANSITIONAL — being migrated to the XENO gateway; do not add new provider keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================
# OPENROUTER API KEY
# ==============================================
# TRANSITIONAL — being migrated to the XENO gateway; do not add new provider keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================
# (Replicate + Topaz REMOVED 2026-07-17 — XENO-ONLY policy: the platform holds NO
# third-party provider keys. Image gen = in-house Xeno Flow; all other inference =
# the XENO API at api.xenostudio.ai. Do NOT re-add direct provider keys here.)
# ==============================================

# ==============================================
# SECURITY & AUTH (CRITICAL — must set in production)
# ==============================================
# JWT secret — MUST be changed from default in production (min 32 bytes)
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Database password — MUST be changed from default
POSTGRES_PASSWORD=change-me-in-production

# Admin user password — MUST be changed from default
ADMIN_PASSWORD=change-me-in-production

# ==============================================
# HOSTNAMES — the ONE seam (src/server/config/hosts.js)
# ==============================================
# Leave ALL of these unset to keep today's behaviour exactly: every hostname
# falls back to the frozen xenostudio.ai defaults. Setting them is how a domain
# migration happens WITHOUT a code change.
#
# Canonical identity. Moving these is the semantic flip — it changes what the
# server MINTS (OIDC `iss`, email links, OAuth callbacks, Stripe return URLs).
# Do this last, in a maintenance window, after every client is rebuilt.
# XENO_SITE_ORIGIN=https://xenostudio.ai
# XENO_API_ORIGIN=https://api.xenostudio.ai
# XENO_UPDATES_ORIGIN=https://updates.xenostudio.ai
#
# Additive allowlists. Widening these is safe, individually revertible, and is
# how you dual-home: the server ACCEPTS a second host without changing anything
# it mints. Do this FIRST, and leave the old hosts here permanently.
# XENO_ALIAS_SITE_ORIGINS=https://xenosystem.ai,https://www.xenosystem.ai
# XENO_API_ORIGINS_EXTRA=https://api.xenosystem.ai
#
# ⚠️ The OIDC issuer is NOT in the additive category. `iss` is compared for
# exact equality by every relying party (OIDC Core §3.1.3.7) and RFC 8414 §3.3
# binds the discovery document to the URL it was fetched from. There is no
# "accept both issuers" — see XENO DOMAIN MIGRATION - AUDIT.md.
# OIDC_ISSUER=https://xenostudio.ai
#
# ⚠️ MAIL_PRIMARY_DOMAIN is deliberately pinned SEPARATELY and must not ride
# along with XENO_SITE_ORIGIN: handle@domain is persisted into users.email and
# the gateway resolves users by email, so moving it is a data migration.
# MAIL_PRIMARY_DOMAIN=xenostudio.ai

# CORS origins (comma-separated, used in production).
# If unset, derived from XENO_SITE_ORIGIN + www + XENO_ALIAS_SITE_ORIGINS,
# plus the two localhost dev origins — prefer leaving this unset and using the
# alias list, so there is one place to widen rather than two.
CORS_ORIGINS=https://xenostudio.ai,https://www.xenostudio.ai

# Cookie domain for auth cookies.
# NOTE: as of this writing COOKIE_DOMAIN is declared but READ BY NOTHING —
# `git grep COOKIE_DOMAIN src/` finds no source reference. Platform auth is
# header-bearer only (`middleware/auth.js`: "Header-only by design — the app
# authenticates via Authorization: Bearer and sets NO auth cookie"). This is
# load-bearing good news for dual-homing: there is no cookie Domain scoping
# problem to solve, because there is no auth cookie. Do not introduce one
# without re-reading XENO DOMAIN MIGRATION - AUDIT.md §Phase 3.
COOKIE_DOMAIN=.xenostudio.ai

# Frontend URL for OAuth redirects
AUTH_FRONTEND_URL=https://xenostudio.ai

# ==============================================
# STRIPE BILLING (pay path → credit ledger)
# ==============================================
# The server runs fully WITHOUT these — /api/billing endpoints return 503 until
# STRIPE_SECRET_KEY is set. No other product is affected. Get keys at:
#   https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret — `stripe listen` (dev) or the dashboard endpoint (prod).
# Point the endpoint at: https://xenostudio.ai/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Absolute app URL for Checkout success/cancel redirects (falls back to req origin).
BILLING_APP_URL=https://xenostudio.ai
#
# Stripe Price IDs — create Products + Prices in the Stripe dashboard and paste
# their price_… ids below. Prices are EUR. An item with no price id shows as
# unavailable (no error). The amounts + credit grants are the AUTHORITATIVE CATALOG
# in billingService.js — keep the Stripe Prices in sync with it (advertised==charged
# is verified LIVE against the Stripe Price at checkout).
#   CREDITS_SMALL     → one-time      1,000 credits  (€10)   "Starter"
#   CREDITS_MEDIUM    → one-time      5,500 credits  (€50)   "Plus" — best value
#   CREDITS_LARGE     → one-time     12,000 credits  (€100)  "Pro pack"
#   PRO_MONTHLY       → subscription  Pro  €24/mo — gates FEATURES only (no watermark,
#                       commercial use, 4K, priority, unlimited in-house, private projects).
#                       Subscriptions grant NO monthly credits (locked monetization model).
#   TEAM_SEAT_MONTHLY → subscription  Team €40/seat/mo — Pro features + 5 team seats;
#                       billed PER SEAT (Checkout quantity = seat count). This is the
#                       Team price the UI uses.
#   TEAM_MONTHLY      → subscription  Team (LEGACY flat €60/mo) — optional; leave unset.
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_SEAT_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# ==============================================
# DEVELOPMENT/TESTING VARIABLES
# ==============================================
# Test variable for development purposes
VITE_TEST_VAR=test_value

# Backend server port (to avoid conflicts)
BACKEND_PORT=3003

# API URL for frontend to connect to backend
VITE_API_URL=http://localhost:8081

# ==============================================
# SITE-WIDE PASSWORD PROTECTION
# ==============================================
# Enable/disable the password gate for the entire website
# Set to 'true' to enable, 'false' to disable
VITE_ENABLE_SITE_GATE=false

# The password required to access the site when gate is enabled
# This is a frontend-only protection for beta/construction mode
# WARNING: Not secure - password visible in frontend bundle
VITE_SITE_PASSWORD=your_secret_password_here

# ==============================================
# OPTIONAL: XENO SEARCH SERVICE
# ==============================================
# If you have a custom search service
XENO_SEARCH_API_KEY=your_xeno_search_api_key_here
XENO_SEARCH_ENDPOINT=your_xeno_search_endpoint_here
# Server-side credentials for the optional provider-specific Search tabs.
# GOOGLE_SEARCH_CX is the canonical platform variable; compose maps it to the
# search service's GOOGLE_CX setting.
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
BRAVE_API_KEY=

# ==============================================
# OPTIONAL: CLI REMOTE RUNNER
# ==============================================
# Leave unset to advertise no hosted run capabilities.
# Example: XENO_REMOTE_RUNNER_COMMAND=xeno
# Default args when enabled: run --json {prompt}
XENO_REMOTE_RUNNER_COMMAND=
XENO_REMOTE_RUNNER_ARGS_JSON=
XENO_REMOTE_RUNNER_CWD=
XENO_REMOTE_RUNNER_MAX_CONCURRENT=1
XENO_REMOTE_RUNNER_AUTOSCALE=false
XENO_REMOTE_RUNNER_AUTOSCALE_MIN=1
XENO_REMOTE_RUNNER_AUTOSCALE_MAX=
XENO_REMOTE_RUNNER_TIMEOUT_MS=1800000
XENO_REMOTE_RUNNER_RETENTION=100
XENO_REMOTE_RUNNER_MAX_PROMPT_CHARS=20000
XENO_REMOTE_RUNNER_MAX_EVENT_TEXT_CHARS=16000
# Comma-separated env var names to pass into runner child processes.
# Server env is not inherited by default.
XENO_REMOTE_RUNNER_ENV_ALLOWLIST=
# Optional: copy this server env var into XENO_API_KEY for the runner child.
XENO_REMOTE_RUNNER_API_KEY_ENV=

# ==============================================
# XENO EXTENSION RELEASES
# ==============================================
EXTENSION_RELEASES_REPO=XENO-CORPORATION/xeno-extension
GITHUB_TOKEN=
EXTENSION_CHROME_STABLE_URL=
EXTENSION_CHROME_BETA_URL=
EXTENSION_CHROME_PREVIEW_URL=
EXTENSION_EDGE_STABLE_URL=
EXTENSION_EDGE_BETA_URL=
EXTENSION_EDGE_PREVIEW_URL=
EXTENSION_SAFARI_STABLE_URL=
EXTENSION_SAFARI_BETA_URL=
EXTENSION_SAFARI_PREVIEW_URL=
